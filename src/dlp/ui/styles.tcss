Screen {
    background: $surface;
    color: $text;
}

Header {
    background: $panel;
    color: $text;
}

Footer {
    background: $panel;
    color: $text-muted;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 2;
}

.section-title {
    color: $text;
    text-style: bold;
    margin: 0 0 1 0;
}

.subsection {
    color: $primary;
    text-style: bold;
    margin: 1 0 1 0;
}

.muted {
    color: $text-muted;
}

.status {
    height: auto;
    min-height: 2;
    padding: 1;
    border: round $primary;
    margin: 1 0;
}

#url-input {
    height: 8;
    border: tall $primary;
    margin: 1 0;
}

#queue-table {
    height: 1fr;
    border: round $primary;
}

#history-table {
    height: 1fr;
    border: round $primary;
}

#queue-filter {
    margin: 0 0 1 0;
}

#preview-status {
    border: round $secondary;
}

#formats-status {
    border: round $secondary;
    max-height: 10;
    overflow-y: auto;
}

#retry-button {
    margin-top: 1;
}

.form-row {
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
}

.form-label {
    width: 24;
    padding: 1 1 0 0;
    color: $text-muted;
}

.form-control {
    width: 1fr;
}

#settings-tab > VerticalScroll {
    height: 1fr;
}

#settings-actions {
    dock: bottom;
    height: auto;
    padding: 1 0 0 0;
    background: $surface;
}

#extra-args {
    height: 8;
    border: tall $primary;
}

#advanced-help {
    height: auto;
    min-height: 3;
    padding: 1;
    border: round $secondary;
    margin: 0 0 1 0;
}

#advanced-status {
    margin-top: 0;
}

.button-row {
    height: auto;
    margin: 1 0;
}

Button {
    margin: 0 1 0 0;
}

#dependency-dialog {
    width: 90%;
    max-width: 70;
    min-width: 30;
    height: 80%;
    max-height: 90%;
    padding: 2;
    border: round $primary;
    background: $panel;
}

DependencyDialog {
    align: center middle;
    background: $background;
}

#dependency-dialog #dependency-actions {
    margin-top: 2;
    height: auto;
}

#dependency-command-scroll {
    height: 1fr;
    min-height: 4;
    border: round $secondary;
    padding: 1;
}

#dependency-dialog #dependency-actions Button {
    width: 100%;
    margin: 0 0 1 0;
}
